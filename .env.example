# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string — used by the app at runtime.
# Neon: Dashboard → Connect → "Connection pooling" ON (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (unpooled) connection string — used only by `prisma migrate`.
# Neon: the same dialog with "Connection pooling" OFF (no "-pooler" in host).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ byte hex secret for signing session JWTs: `openssl rand -hex 32`
SESSION_SECRET="replace-with-random-hex"

# ---------------------------------------------------------------------------
# Root account created by `npm run db:seed`
# Keep these OUT of version control and rotate the password after first login.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-please"
SUPER_ADMIN_NAME="Super Admin"
