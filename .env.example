# SQLite database file, resolved relative to the project root
DATABASE_URL="file:./prisma/dev.db"
# 32+ byte hex secret for signing session JWTs: `openssl rand -hex 32`
SESSION_SECRET="replace-with-random-hex"

# Root account created by `npm run db:seed`.
# Keep these OUT of version control and rotate the password after first login.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-please"
SUPER_ADMIN_NAME="Super Admin"
